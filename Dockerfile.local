# Lightweight image built from PRE-BUILT local artifacts.
# Build artifacts locally first (avoids the heavy in-container multi-stage build):
#   cd backend  && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -buildvcs=false \
#                    -ldflags="-s -w -buildid=" -o bin/clawreef-server ./cmd/server
#   cd frontend && npm run build
# Then: docker build -f Dockerfile.local -t clawreef:local .
FROM nginx:1.27-alpine

RUN apk add --no-cache dumb-init openssl gettext nginx-module-njs

WORKDIR /app

COPY backend/bin/clawreef-server /usr/local/bin/clawreef-server
COPY frontend/dist /usr/share/nginx/html
COPY deployments/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deployments/nginx/includes/ /etc/nginx/includes/
COPY deployments/nginx/njs/desktop_auth.js /etc/nginx/njs/desktop_auth.js
COPY deployments/container/start.sh /app/start.sh

RUN chmod +x /app/start.sh /usr/local/bin/clawreef-server \
    && mkdir -p /etc/nginx/tls /var/log/clawreef

EXPOSE 8443

ENTRYPOINT ["dumb-init", "--"]
CMD ["/app/start.sh"]
